@using Microsoft.AspNetCore.Identity
@using PetHealthManagement.Web.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    @* ゲストはアカウント管理（メールアドレス・パスワード等）を使えないため、導線を出さない *@
    if (!PetHealthManagement.Web.Infrastructure.GuestIdentity.IsGuest(User))
    {
        <li class="nav-item">
            <a class="nav-link" href="/Identity/Account/Manage" title="アカウント管理">
                アカウント
            </a>
        </li>
    }
    <li class="nav-item">
        <form class="form-inline" asp-area="Identity" asp-controller="Account" asp-action="Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="nav-link btn btn-link">ログアウト</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-controller="Account" asp-action="Register">新規登録</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-controller="Account" asp-action="Login">ログイン</a>
    </li>
}
</ul>
