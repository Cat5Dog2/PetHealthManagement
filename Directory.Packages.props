<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- バージョンはここに literal で書く（MSBuild プロパティで束ねない）。
       Dependabot が $(Var) 形式を解決できなかった場合、更新 PR が黙って作られなくなり、
       CPM 導入の目的（バージョンずれの検知）と正反対の結果になるため。
       ASP.NET Core / EF Core を同時に上げる役目は .github/dependabot.yml の
       aspnetcore-efcore グループが担う。 -->

  <ItemGroup Label="ASP.NET Core / EF Core">
    <PackageVersion Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="Azure">
    <PackageVersion Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.5" />
    <PackageVersion Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.6.5" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
  </ItemGroup>

  <!-- SkiaSharp と NativeAssets は版が一致しないと実行時にネイティブライブラリの読み込みで失敗する。
       同時に上げる役目は .github/dependabot.yml の skiasharp グループが担う。
       Linux 用（本番の App Service / CI）は SkiaSharp 本体に含まれないため明示的に参照する。 -->
  <ItemGroup Label="Application">
    <PackageVersion Include="SkiaSharp" Version="4.153.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
  </ItemGroup>

  <!-- 推移的依存の脆弱性を、直接参照して修正版に引き上げる。
       Pkcs：EF Core SqlServer → Microsoft.Data.SqlClient 6.1.7 が 9.0.11 を引き込み、
       GHSA-846f-f764-76mx / GHSA-2fmv-rv2c-59x7 に該当する。
       SqlClient 側が修正版を参照するようになったら、csproj の参照ごと外す。 -->
  <ItemGroup Label="Transitive overrides">
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Microsoft.Playwright.Xunit" Version="1.64.1" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

</Project>
